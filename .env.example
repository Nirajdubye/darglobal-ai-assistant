# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Must be 'openrouter/free' or a model id ending in ':free' (paid models are rejected).
OPENROUTER_MODEL=openrouter/free

# Optional: protects POST /admin/ingest. Leave empty to disable the endpoint.
ADMIN_TOKEN=

# Where the Streamlit UI finds the API.
API_URL=http://localhost:8000

# Optional tuning
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# TOP_K=6
# MIN_SIMILARITY=0.30
